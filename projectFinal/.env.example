# Copy to .env (never commit .env) or set these in your host's dashboard.
# Generate SECRET_KEY with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
MAIL_USERNAME=
MAIL_PASSWORD=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Chatbot. Local Ollama app: keep these two lines and leave OLLAMA_API_KEY empty.
OLLAMA_URL=http://127.0.0.1:11434/api/chat
OLLAMA_MODEL=gemma4:31b-cloud
OLLAMA_API_KEY=

# Folder for the database and uploaded scans. Point it at a persistent disk in production.
# DATA_DIR=/var/data
